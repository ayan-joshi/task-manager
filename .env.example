# ---- Root environment (consumed by docker-compose) ----
# Copy to .env and adjust before running `docker compose up`.

# Secret used to sign JWTs (min 16 chars). Generate a strong random value.
JWT_SECRET=local-development-secret-change-me

# Optional admin account seeded on first backend boot.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin12345

# ---------------------------------------------------------------------------
# Per-app variables (see apps/backend/.env.example and apps/frontend/.env.example
# for the full list used during local, non-Docker development):
#
#   Backend:  DATABASE_URL, JWT_SECRET, PORT, ALLOWED_ORIGINS, UPLOAD_DIR, ...
#   Frontend: NEXT_PUBLIC_API_URL
# ---------------------------------------------------------------------------
