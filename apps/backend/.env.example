# ---- Backend environment ----

# PostgreSQL connection string (required)
DATABASE_URL=postgres://taskmanager:taskmanager@localhost:5432/taskmanager?sslmode=disable

# JWT signing secret (required, min 16 chars). Generate a strong random value in production.
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRY_HOURS=72

# HTTP server port
PORT=8080

# Comma-separated list of allowed CORS origins (the frontend URL)
ALLOWED_ORIGINS=http://localhost:3000

# File uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
ALLOWED_MIME_TYPES=image/png,image/jpeg,image/gif,image/webp,application/pdf,text/plain

# Rate limiting (per client IP)
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=20

# Environment: development | production
ENVIRONMENT=development

# Optional: auto-create an ADMIN user on startup if it does not exist
SEED_ADMIN_NAME=Administrator
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin12345
